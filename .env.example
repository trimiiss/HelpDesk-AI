# Copy this file to .env and fill in the values. .env is ignored by git.
# To try the system with no accounts at all, skip this file and run `npm run sim:up`.

# Starts the ngrok tunnel with `docker compose up`.
COMPOSE_PROFILES=tunnel

# --- Required for real calls ------------------------------------------------
# OpenAI key on a paid tier (the free tier cannot use the Realtime API).
# This is all you need for the browser test phone: `npm run phone:up`.
OPENAI_API_KEY=

# Twilio Console > Account Info.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ngrok dashboard > Your Authtoken, and Domains (your free static domain).
NGROK_AUTHTOKEN=
# Domain only, with no https:// prefix. Example: my-helpdesk.ngrok-free.app
NGROK_DOMAIN=

# --- Admin page -------------------------------------------------------------
# Create the hash with: npm run admin:hash -- "your password"
ADMIN_PASSWORD_HASH=
# Any random text of at least 32 characters.
ADMIN_SESSION_SECRET=

# --- Recommended ------------------------------------------------------------
# Where transfers go, in international format, for example +38344123456.
# It is also the fallback if the AI fails mid-call. If left empty, the agent
# says transfers are unavailable and a failed call hangs up.
TRANSFER_NUMBER=

# --- Email for callback messages --------------------------------------------
# Left empty, emails go to Mailpit at http://localhost:8025 and nowhere else.
# Example: smtp://user:password@smtp.example.com:587
SMTP_URL=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# --- Optional (defaults shown) ----------------------------------------------
# Switch to gpt-realtime-2.1 if Albanian is too weak on the mini model.
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=marin
# minimal | low | medium | high | xhigh
REALTIME_REASONING_EFFORT=low
TRANSCRIPTION_MODEL=gpt-transcribe
EMBEDDING_MODEL=text-embedding-3-small

# How close a search result must be to count as an answer. Tune with `npm run eval:rag`.
SEARCH_MIN_SIMILARITY=0.3

# Turn detection. Raise VAD_THRESHOLD if line noise interrupts the agent.
VAD_THRESHOLD=0.5
VAD_PREFIX_PADDING_MS=300
VAD_SILENCE_DURATION_MS=500

MAX_CALL_SECONDS=600
GOODBYE_LEAD_SECONDS=30

POSTGRES_PASSWORD=helpdesk-dev
GRAFANA_PASSWORD=admin

LOG_LEVEL=info
# Prints what was said to the logs so you can judge language quality.
# Transcripts are personal data, so keep this off outside local testing.
LOG_TRANSCRIPTS=true
