# Talk to the real AI through your browser, with no phone number or Twilio account.
# Layered over your .env, which supplies OPENAI_API_KEY and the admin password.
#
#   npm run phone:up
#   http://localhost:9000

COMPOSE_PROFILES=sim
SIM_AI=real

TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=sim-token
TWILIO_API_BASE_URL=http://sim:9000

NGROK_AUTHTOKEN=unused
NGROK_DOMAIN=helpdesk.sim.invalid
