# Runs everything with no accounts: a fake AI, a fake Twilio and local embeddings.
# Nothing here is a real secret, and the stack only listens on localhost.
#
#   npm run sim:up      Start the system
#   npm run sim:call    Run a scripted call through it
#   http://localhost:9000  Type a conversation in the browser

COMPOSE_PROFILES=sim
SIM_AI=fake

OPENAI_API_KEY=sim-key
OPENAI_REALTIME_URL=ws://sim:9000/v1/realtime
EMBEDDING_PROVIDER=local
# Spelling-based local embeddings score lower than OpenAI's.
SEARCH_MIN_SIMILARITY=0.2

TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=sim-token
TWILIO_API_BASE_URL=http://sim:9000
TRANSFER_NUMBER=+10000000003

NGROK_AUTHTOKEN=unused
NGROK_DOMAIN=helpdesk.sim.invalid

# Admin UI at http://localhost:8082 with the password demo-password
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:c90405d6acb7f9c7c8450da23a9c9dc6:afe1bea4aa9d44fa86a52e6cb4c79fe3466bfc1d294042dfcea443ac506f40a7
ADMIN_SESSION_SECRET=sim-session-secret-not-for-real-use

LOG_TRANSCRIPTS=true
